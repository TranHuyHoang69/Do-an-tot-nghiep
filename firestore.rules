rules_version = '1';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false;

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidTransaction(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /categories/{catId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidCategory(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidBudget(request.resource.data)
          && validBudgetRevision(request.resource.data)
          && request.resource.data.revision == 1;
        allow update: if isOwner(userId)
          && isValidBudget(request.resource.data)
          && validBudgetRevision(request.resource.data)
          && request.resource.data.revision == resource.data.get('revision', 0) + 1
          && request.resource.data.lastOperationId != resource.data.get('lastOperationId', '')
          && (!resource.data.get('isArchived', false)
              || request.resource.data.isArchived
              || request.resource.data.get('recreatedFromTombstone', false) == true);
        allow delete: if false;
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidReminder(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /recurring_transactions/{recurringId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidRecurringTransaction(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTransaction(data) {
      return data.amountMinor is int && data.amountMinor >= 0
        && data.type in ['INCOME', 'EXPENSE']
        && data.categoryLocalId is string && data.categoryLocalId.size() > 0;
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0
        && data.type in ['INCOME', 'EXPENSE'];
    }

    function isValidBudget(data) {
      return data.amountMinor is int && data.amountMinor >= 0
        && data.categoryLocalId is string && data.categoryLocalId.size() > 0
        && data.effectiveMonth is int && data.effectiveMonth >= 1 && data.effectiveMonth <= 12
        && data.effectiveYear is int;
    }

    function validBudgetRevision(data) {
      return data.get('revision', -1) is int && data.revision > 0
        && data.get('lastOperationId', '') is string
        && data.lastOperationId.size() > 0
        && data.get('isArchived', false) is bool;
    }

    function isValidReminder(data) {
      return data.title is string && data.title.size() > 0
        && data.triggerAt is int
        && data.repeatRule in ['NONE', 'DAILY', 'WEEKLY', 'MONTHLY'];
    }

    function isValidRecurringTransaction(data) {
      return data.localId is string && data.localId.size() > 0
        && data.userId is string && data.userId == request.auth.uid
        && data.type in ['INCOME', 'EXPENSE']
        && data.amountMinor is int && data.amountMinor > 0
        && data.currency is string && data.currency.size() > 0
        && data.categoryLocalId is string && data.categoryLocalId.size() > 0
        && data.frequency in [
          'DAILY', 'WEEKLY', 'EVERY_TWO_WEEKS', 'EVERY_FOUR_WEEKS',
          'MONTHLY', 'EVERY_TWO_MONTHS', 'QUARTERLY',
          'EVERY_SIX_MONTHS', 'YEARLY'
        ]
        && data.startAt is int
        && data.timeZoneId is string && data.timeZoneId.size() > 0
        && data.nextOccurrenceIndex is int
        && data.nextRunAt is int
        && data.isActive is bool
        && data.createdAt is int
        && data.updatedAt is int;
    }
  }
}
